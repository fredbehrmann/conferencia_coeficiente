# Copie para .env e ajuste. O arquivo .env não vai para o GitHub.

# Senha da conta "admin" criada na primeira subida, se o banco ainda não tem nenhuma conta.
# Vazio: vale a senha inicial entregue ao responsável. Depois da primeira subida, esta variável é ignorada;
# troque a senha pela tela "Minha senha" ou com: python -m validacao usuario senha admin
CONFERENCIA_ADMIN_SENHA=

# Chave que assina o cookie de sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
CONFERENCIA_SEGREDO=

# 1 quando a aplicação estiver atrás de HTTPS (cookie só trafega cifrado).
CONFERENCIA_COOKIE_SEGURO=0

# IPs dos proxies reversos confiáveis (para respeitar X-Forwarded-For/Proto).
CONFERENCIA_PROXIES=127.0.0.1
