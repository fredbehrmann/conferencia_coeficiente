# Copie para .env e ajuste. O arquivo .env não vai para o GitHub.

# Senha compartilhada exigida na tela de entrada (deixe vazio só para uso local).
CONFERENCIA_SENHA=troque-esta-senha

# Chave que assina o cookie de sessão. Gere uma com:
#   python -c "import secrets; print(secrets.token_hex(32))"
CONFERENCIA_SEGREDO=

# 1 quando a aplicação estiver atrás de HTTPS (cookie só trafega cifrado).
CONFERENCIA_COOKIE_SEGURO=0

# IPs dos proxies reversos confiáveis (para respeitar X-Forwarded-For/Proto).
CONFERENCIA_PROXIES=127.0.0.1
